# RevivePay Phase 4 local/demo configuration (all payments remain synthetic)
APP_NAME=RevivePay API
VERSION=0.4.0
# Supported labels, grouped by the profile each one resolves to:
#   local      -> local, development, dev
#   demo       -> demo
#   test       -> test, testing, ci
#   staging    -> staging, stage
#   production -> production, prod
# local/demo/test may run AUTH_MODE=disabled. staging/production require
# AUTH_MODE=api_key, a non-empty API_KEY, and explicit (non-wildcard) CORS origins,
# refuse create_all/drop_all bootstrap, and refuse the destructive demo reset.
# Any other label is rejected at startup rather than given a guessed policy.
ENVIRONMENT=development
API_PREFIX=/api
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./revivepay.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=1048576
MAX_PAGE_LIMIT=100
MAX_PAGE_OFFSET=10000

# Local/demo auth is intentionally disabled. Production requires api_key + key.
AUTH_MODE=disabled
# API_KEY=replace-with-a-long-random-secret
API_KEY_SCOPES=operations:write,demo:reset

# Direct execution preserves deterministic demos. Production requires enqueue.
EXECUTION_MODE=synchronous
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3

SIMULATION_SEED=20260101
VIRTUAL_CLOCK_START=2026-01-01T13:00:00
VIRTUAL_CLOCK_STATE_PATH=./.revivepay_clock.json
RETRY_LATER_DELAY_MINUTES=15
MAX_AUTOMATIC_RETRIES=2
REPEATED_FAILURE_LIMIT=3
HIGH_VALUE_ESCALATION_THRESHOLD=5000000
ALLOW_HUMAN_ESCALATION=true
DIAGNOSIS_ENGINE_IMPL=rule_based
RECOVERY_PREDICTOR_IMPL=deterministic
ACTION_EXECUTOR_IMPL=simulator
LOCAL_MODEL_ARTIFACT_PATH=./artifacts/recovery_logistic_model.json
LOCAL_MODEL_TRAINING_STEPS=240
LOCAL_MODEL_LEARNING_RATE=0.12
AI_DIAGNOSIS_PROVIDER=local_mock
AI_COPILOT_PROVIDER=local_mock
RATE_LIMIT_REQUESTS_PER_MINUTE=120
DEFAULT_CURRENCY=INR

# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=store-only-in-local-or-deployment-secret-manager
# RAZORPAY_WEBHOOK_SECRET=set-a-distinct-dashboard-webhook-secret
# RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
# RAZORPAY_TIMEOUT_SECONDS=10

# PostgreSQL production example (psycopg v3):
# DATABASE_URL=postgresql+psycopg://revivepay:strong-password@postgres:5432/revivepay
# ENVIRONMENT=production
# AUTH_MODE=api_key
# API_KEY=generate-a-32-byte-or-longer-random-secret
# EXECUTION_MODE=enqueue
# BACKEND_CORS_ORIGINS=https://app.example.com

# Optional application description shown in OpenAPI.
# APP_DESCRIPTION=Deterministic synthetic revenue recovery operations platform.
# Optional JSON valuation and simulator overrides (minor units where applicable).
# INTERVENTION_COST_MINOR={"RETRY_NOW":500,"RETRY_LATER":2000,"SEND_PAYMENT_LINK":3000,"CHANGE_PAYMENT_METHOD":3000,"SEND_REMINDER":1000,"ESCALATE_HUMAN":50000,"STOP":0}
# FRICTION_PENALTY_MINOR={"RETRY_NOW":2000,"RETRY_LATER":10000,"SEND_PAYMENT_LINK":15000,"CHANGE_PAYMENT_METHOD":20000,"SEND_REMINDER":8000,"ESCALATE_HUMAN":0,"STOP":0}
# SIMULATOR_SUCCESS_PROBABILITY={"BANK_TIMEOUT:RETRY_NOW":0.35}
# SIMULATOR_FALLBACK_PROBABILITY=0.30
