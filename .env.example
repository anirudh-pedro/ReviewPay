# ============================================================================
# RevivePay Phase 0 — environment configuration
# Copy to `.env` and adjust:   Copy-Item .env.example .env
#
# Every value below has a working local default, so the application runs with no
# .env file at all. Nothing here requires a paid API key or network access.
# ============================================================================

# --- Application metadata ---
APP_NAME=RevivePay API
VERSION=0.1.0
ENVIRONMENT=development

# Shown on the generated /docs page. Default lives in app/core/config.py.
# APP_DESCRIPTION=Autonomous revenue recovery for merchants.

# API mount prefix. GET /health is served outside this prefix.
API_PREFIX=/api

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database ---
# SQLite for Phase 0. Swapping to PostgreSQL requires changing this value alone.
DATABASE_URL=sqlite:///./revivepay.db
DB_ECHO=false

# Allowed frontend origins for CORS (comma-separated). No frontend ships in
# Phase 0; these are here so a later dashboard needs no code change.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# SIMULATION — synthetic demonstration values
#
# No real money moves. Every figure the system reports is the result of a
# deterministic simulation over synthetic data.
# ============================================================================

# Seeds every simulator outcome. Identical seed => identical demo, on any machine.
SIMULATION_SEED=20260101

# Simulation time starts here. 13:00 makes the canonical demo timeline
# (fail 13:00 -> schedule 13:16 -> advance 15m -> retry) read naturally.
VIRTUAL_CLOCK_START=2026-01-01T13:00:00

# Simulation time is persisted here so the API process and CLI scripts share one
# timeline. Delete the file to reset the clock.
VIRTUAL_CLOCK_STATE_PATH=./.revivepay_clock.json

# How far ahead RETRY_LATER schedules its retry.
RETRY_LATER_DELAY_MINUTES=15

# --- Policy thresholds ---
# Retry attempts permitted before the retry-limit rule stops the case.
MAX_AUTOMATIC_RETRIES=2

# Unsuccessful verified outcomes permitted before the repeated-failure rule blocks.
REPEATED_FAILURE_LIMIT=3

# Payments above this amount escalate to a human instead of recovering
# automatically. MINOR UNITS (paise): 5000000 = INR 50,000.
HIGH_VALUE_ESCALATION_THRESHOLD=5000000

# When false, cases that would escalate are blocked instead.
ALLOW_HUMAN_ESCALATION=true

# --- Component implementations (Phase 1 registers alternatives here) ---
DIAGNOSIS_ENGINE_IMPL=rule_based
RECOVERY_PREDICTOR_IMPL=deterministic
ACTION_EXECUTOR_IMPL=simulator

# --- Currency ---
# All monetary values are integer MINOR UNITS (paise for INR).
DEFAULT_CURRENCY=INR

# ============================================================================
# Optional overrides — JSON objects, in MINOR UNITS.
# Defaults live in app/core/config.py and are documented there.
# Uncomment to override.
# ============================================================================

# Cost of performing each recovery action.
# INTERVENTION_COST_MINOR={"RETRY_NOW":500,"RETRY_LATER":2000,"SEND_PAYMENT_LINK":3000,"CHANGE_PAYMENT_METHOD":3000,"SEND_REMINDER":1000,"ESCALATE_HUMAN":50000,"STOP":0}

# Customer-experience penalty charged against each action's expected value.
# FRICTION_PENALTY_MINOR={"RETRY_NOW":2000,"RETRY_LATER":10000,"SEND_PAYMENT_LINK":15000,"CHANGE_PAYMENT_METHOD":20000,"SEND_REMINDER":8000,"ESCALATE_HUMAN":0,"STOP":0}

# Simulator success rates for pairs that are not deterministically scripted,
# keyed "FAILURE_REASON:ACTION_TYPE". SYNTHETIC DEMONSTRATION VALUES.
# SIMULATOR_SUCCESS_PROBABILITY={"BANK_TIMEOUT:RETRY_NOW":0.35,"NETWORK_ERROR:RETRY_NOW":0.60}

# Fallback success rate for any pair absent from the map above.
SIMULATOR_FALLBACK_PROBABILITY=0.30
