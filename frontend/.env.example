# ============================================================================
# RevivePay Command Center — frontend environment
# Copy to `.env.local`:   Copy-Item .env.example .env.local
# ============================================================================

# Base URL for the RevivePay API. Do not include the API mount path here.
#
# Leave empty in development: Vite proxies API calls to the backend, so the
# browser sees one origin and no CORS setup is needed.
#
# Set this for a static production build served from a different origin,
# e.g. VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Must match the backend API_PREFIX. The local FastAPI default is /api.
VITE_API_PREFIX=/api

# Where the Vite dev server proxies API calls and /health.
VITE_PROXY_TARGET=http://127.0.0.1:8000
